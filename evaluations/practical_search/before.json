  {
   "criterion": "saved",
   "evidence": "the step's outcome",
   "fail": "refused",
   "unverified": "not run, input missing"
  },
  {
   "criterion": "approval",
   "evidence": "approved_audit.approval (the save is this proposal's; every moved element and panel approved by it, every approved one changed)",
   "fail": "an id not approved or not this proposal's",
   "unverified": "audit not run"
  },
  {
   "criterion": "approved changes as approved",
   "evidence": "approved_audit.approved (translations, panel extensions, the new text in its frame)",
   "fail": "a change not made exactly as approved",
   "unverified": "a change kind the audit cannot check"
  },
  {
   "criterion": "protection of what was not approved",
   "evidence": "approved_audit.protected (glyphs, drawings, images, annotations, pixels, other pages, fonts) for every step it audits; the existing region audit (safety) besides for a faithful step; for a layout step the region audit fails by design and is shown, not counted",
   "fail": "any change outside the approved areas",
   "unverified": "not audited"
  },
  {
   "criterion": "structure and links",
   "evidence": "structure_audit, links_audit",
   "fail": "a tag or link changed",
   "unverified": "(not required when not measured)"
  },
  {
   "criterion": "quality (extraction of the page, sizes and colours)",
   "evidence": "approved_audit.quality (and the existing quality for a faithful step)",
   "fail": "any check false",
   "unverified": "a check not made"
  },
  {
   "criterion": "search and copy of the edited text",
   "evidence": "search_copy (issue #114): one line: search_full, extraction_mupdf, extraction_poppler, copy_equivalent; over lines: search_per_line, extraction_mupdf, extraction_poppler, copy_equivalent (search_full recorded, not required); a deletion: not applicable",
   "fail": "any required measure false (a gap of the source too: as_in_source does not pass it)",
   "unverified": "a required measure null, or the measures not made"
  }
