!/evaluations/continuation/source-slot-ownership-summary.json
!/evaluations/continuation/source-output-canonical-summary.json
!/evaluations/continuation/source-output-external-summary.json
/evaluations/continuation/runs/

!/evaluations/anchors/paint-ownership-summary.json
!/evaluations/critical_path/probe-results.json

# Semantic lifecycle external validation: commit only result.json + report.md per run (artifacts/logs stay local).
!/evaluations/semantic_lifecycle/runs/*/result.json

# Paragraph/frame architecture PoC: text evidence only.
!/evaluations/architecture_poc/manifest.json
!/evaluations/architecture_poc/results.json
!/evaluations/architecture_poc/audits/*.json

# Paragraph-frame continuous editing: manifest, compact results and reproduction only.
# Generated PDFs, rasters and detailed audit JSON stay under tmp/ (regenerable).
!/evaluations/paragraph_frame_continuity/manifest.json
!/evaluations/paragraph_frame_continuity/results.json

# Paragraph-frame column flow: manifest (frozen before evaluation) and compact results only.
!/evaluations/paragraph_frame_column_flow/manifest.json
!/evaluations/paragraph_frame_column_flow/results.json

# InDesign-style text support (text matrix/CTM, Form XObject): manifest and compact results only.
!/evaluations/paragraph_frame_indesign/manifest.json
!/evaluations/paragraph_frame_indesign/results.json
!/evaluations/paragraph_frame_tagged/manifest.json
!/evaluations/paragraph_frame_tagged/results.json
!/evaluations/paragraph_frame_fidelity/
!/evaluations/paragraph_frame_fidelity/manifest.json
!/evaluations/paragraph_frame_fidelity/results.json
!/evaluations/paragraph_frame_roundtrip/
!/evaluations/paragraph_frame_roundtrip/manifest.json
!/evaluations/paragraph_frame_roundtrip/results.json
!/evaluations/paragraph_frame_multiedit/
!/evaluations/paragraph_frame_multiedit/manifest.json
!/evaluations/paragraph_frame_multiedit/results.json
!/evaluations/paragraph_frame_placed/
!/evaluations/paragraph_frame_placed/manifest.json
!/evaluations/paragraph_frame_placed/results.json
!/evaluations/paragraph_frame_decoration/
!/evaluations/paragraph_frame_decoration/manifest.json
!/evaluations/paragraph_frame_decoration/results.json
!/evaluations/paragraph_frame_restore/
!/evaluations/paragraph_frame_restore/manifest.json
!/evaluations/paragraph_frame_restore/results.json
!/evaluations/paragraph_frame_chain/
!/evaluations/paragraph_frame_chain/manifest.json
!/evaluations/paragraph_frame_chain/results.json
!/evaluations/paragraph_frame_separate/
!/evaluations/paragraph_frame_separate/manifest.json
!/evaluations/paragraph_frame_separate/results.json
!/evaluations/baseline/
!/evaluations/baseline/*.json
!/evaluations/baseline/README.md
!/evaluations/smoke/
!/evaluations/smoke/manifest.json
!/evaluations/smoke/results.json
# Paragraph and row inference (issue #110): manifest (frozen before the implementation) and compact results only.
!/evaluations/paragraph_rows/manifest.json
!/evaluations/paragraph_rows/results.json
