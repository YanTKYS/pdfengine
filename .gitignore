.venv/
__pycache__/
.pytest_cache/
*.egg-info/
tmp/

# Keep third-party documents and derived binary/raw extraction evidence local.
/output/
/evaluations/**
!/evaluations/**/
!/evaluations/**/*.py
!/evaluations/**/*.md
!/evaluations/sources.json
!/evaluations/backend/backend_matrix.csv
!/evaluations/backend/backend_final_assessment.json
!/evaluations/composition/summary.json
!/evaluations/attributed/summary.json
!/evaluations/elements/summary.json
!/evaluations/anchors/summary.json
!/evaluations/editable/summary.json
!/evaluations/empty_element/summary.json
!/evaluations/document_flow/summary.json
!/evaluations/ink_collision/summary.json
!/evaluations/flow_transaction/summary.json
!/evaluations/variable_container/summary.json
!/evaluations/story_flow/summary.json
!/evaluations/story_styles/summary.json
!/evaluations/shared_flow/summary.json
!/evaluations/spacing/summary.json
!/evaluations/confirmed_style/summary.json
!/evaluations/alignment/summary.json
!/evaluations/continuation/summary.json
!/evaluations/continuation/multi-destination-summary.json
!/evaluations/continuation/boundary-destination-summary.json
!/evaluations/continuation/scope-destination-summary.json
!/evaluations/continuation/scope-entry-summary.json
!/evaluations/continuation/scope-chain-destination-summary.json
!/evaluations/continuation/ctm-source-destination-summary.json
!/evaluations/continuation/depth-three-inspection-summary.json
